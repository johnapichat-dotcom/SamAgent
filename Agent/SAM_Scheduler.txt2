# ==============================================================================
# S.A.M. SCHEDULER  (Smart Agent Management - Orchestrator)
# VERSION     : 3.1.0
# FILE        : SAM_Scheduler.ps1
# ROLE        : Master Orchestrator — ควบคุม Timing, Trigger, และ Task Queue
#               ไม่เก็บข้อมูลระบบเอง, ไม่ sync เอง → เรียก Agent / Update แทน
# ==============================================================================
param(
    [switch]$Setup,          # ติดตั้ง Scheduled Tasks ทั้งหมด
    [switch]$Uninstall,      # ถอน Tasks + ลบโฟลเดอร์
    [switch]$Status          # แสดง Status ของ Tasks ทั้งหมด
)

[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 -bor [Net.SecurityProtocolType]::Tls13

# ==========================================
# CONSTANTS — แก้ตรงนี้จุดเดียว
# ==========================================
$SAM_VERSION     = "3.1.0"
$WorkDir         = "C:\IT_Support"
$LogFile         = "$WorkDir\SAM_Log.txt"
$StateFile       = "$WorkDir\LastState.json"
$ConfigFile      = "$WorkDir\SystemConfig.json"

# Script paths
$AgentScript     = "$WorkDir\SAM_Agent.ps1"
$UpdateScript    = "$WorkDir\SAM_Update.ps1"
$SchedulerScript = "$WorkDir\SAM_Scheduler.ps1"

# Task Names
$TASK_AGENT_SYNC    = "SAM_Agent_Sync"       # Delta sync ทุก 4 ชม.
$TASK_C2_DAY        = "SAM_C2_Poll_Day"      # C2 poll กลางวัน 06:00-17:00 ทุก 40 นาที
$TASK_C2_NIGHT      = "SAM_C2_Poll_Night"    # C2 poll กลางคืน 17:00-06:00 ทุก 80 นาที
$TASK_FULL_SYNC     = "SAM_FullSync_Weekly"  # FullSync ทุกสัปดาห์
$TASK_UPDATE_CHECK  = "SAM_Update_Check"     # ตรวจ update 09:00 + jitter 0-4 ชม.
$TASK_LOG_ROTATE    = "SAM_LogRotate"        # ตัด Log ทุกวัน 10:00

# ==========================================
# UTILITY: Write-SAMLog
# ==========================================
function Write-SAMLog {
    param([string]$Message, [string]$Level = "INFO")
    $Timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    $Line = "$Timestamp [$Level] [Scheduler] $Message"
    try {
        Add-Content -Path $LogFile -Value $Line -Encoding UTF8 -ErrorAction SilentlyContinue
    } catch {}
    if (-not $env:SAM_SILENT) { Write-Host $Line -ForegroundColor Cyan }
}

# ==========================================
# FOLDER BOOTSTRAP
# ==========================================
function Invoke-FolderBootstrap {
    Write-SAMLog "Bootstrapping working directory: $WorkDir"

    cmd.exe /c "takeown /f `"$WorkDir`" /r /d y >nul 2>&1"
    cmd.exe /c "icacls `"$WorkDir`" /reset /T /C /Q >nul 2>&1"
    cmd.exe /c "attrib -h -s -r `"$WorkDir`" /s /d >nul 2>&1"

    if (-not (Test-Path $WorkDir)) {
        New-Item -ItemType Directory -Force -Path $WorkDir | Out-Null
    }

    # ACL: Admins+SYSTEM full, Users read-execute
    cmd.exe /c "icacls `"$WorkDir`" /inheritance:r /quiet >nul 2>&1"
    cmd.exe /c "icacls `"$WorkDir`" /grant Administrators:(OI)(CI)F /T /quiet >nul 2>&1"
    cmd.exe /c "icacls `"$WorkDir`" /grant SYSTEM:(OI)(CI)F /T /quiet >nul 2>&1"
    cmd.exe /c "icacls `"$WorkDir`" /grant Users:(OI)(CI)RX /T /quiet >nul 2>&1"

    # ซ่อนโฟลเดอร์
    try { (Get-Item $WorkDir -Force).Attributes = 'Hidden, System' } catch {}

    Write-SAMLog "Folder bootstrap complete."
}

# ==========================================
# HELPER: Register-SAMTask
# ==========================================
function Register-SAMTask {
    param(
        [string]$TaskName,
        [string]$ScriptFile,
        [string]$ExtraArgs = "",
        [object[]]$Triggers,
        [string]$Description = ""
    )

    $RunUser = "NT AUTHORITY\SYSTEM"
    $PSArgs  = "-WindowStyle Hidden -ExecutionPolicy Bypass -File `"$ScriptFile`""
    if ($ExtraArgs) { $PSArgs += " $ExtraArgs" }

    $Action   = New-ScheduledTaskAction -Execute "powershell.exe" -Argument $PSArgs
    $Settings = New-ScheduledTaskSettingsSet `
        -RunOnlyIfNetworkAvailable `
        -StartWhenAvailable `
        -AllowStartIfOnBatteries `
        -DontStopIfGoingOnBatteries `
        -ExecutionTimeLimit (New-TimeSpan -Minutes 30)

    # ลบ Task เก่าก่อน (ถ้ามี)
    schtasks /delete /tn $TaskName /f 2>$null | Out-Null

    Register-ScheduledTask `
        -TaskName    $TaskName `
        -Action      $Action `
        -Trigger     $Triggers `
        -Settings    $Settings `
        -User        $RunUser `
        -RunLevel    Highest `
        -Description $Description `
        -Force | Out-Null

    Write-SAMLog "Task registered: $TaskName"
}

# ==========================================
# INSTALL: ลงทะเบียน Scheduled Tasks ทั้งหมด
# ==========================================
function Install-SAMTasks {
    Write-SAMLog "=== Installing SAM Scheduled Tasks ==="

    # ลบ Legacy Tasks เก่าๆ
    foreach ($OldTask in @("JARVIS_Smart_Sync","SAM_Smart_Sync","SAM_Agent_DailySync","SAM_C2_Poll","SAM_FullSync_Daily")) {
        schtasks /delete /tn $OldTask /f 2>$null | Out-Null
    }

    # --------------------------------------------------
    # Jitter สุ่มต่อเครื่อง — กระจายเวลาไม่ให้คอขวด
    # แต่ละ Task มี window ของตัวเอง
    $J_Agent   = Get-Random -Min 0  -Max 239   # 0-3:59 นาที  (window 4 ชม.)
    $J_C2Day   = Get-Random -Min 0  -Max 39    # 0-39 นาที    (window 40 นาที)
    $J_C2Night = Get-Random -Min 0  -Max 79    # 0-79 นาที    (window 80 นาที)
    $J_Full    = Get-Random -Min 0  -Max 359   # 0-5:59 นาที  (window กว้าง)
    $J_Update  = Get-Random -Min 0  -Max 239   # 0-3:59 นาที
    $J_Log     = Get-Random -Min 0  -Max 59    # 0-59 นาที

    # คำนวณ Start Time จาก Base + Jitter (นาที)
    $BaseAgent  = [datetime]::Today.AddHours(6).AddMinutes($J_Agent)
    $BaseC2Day  = [datetime]::Today.AddHours(6).AddMinutes($J_C2Day)
    $BaseC2Ngt  = [datetime]::Today.AddHours(17).AddMinutes($J_C2Night)
    $BaseFull   = [datetime]::Today.AddHours(2).AddMinutes($J_Full)
    $BaseUpdate = [datetime]::Today.AddHours(9).AddMinutes($J_Update)
    $BaseLog    = [datetime]::Today.AddHours(10).AddMinutes($J_Log)

    Write-SAMLog "Jitter: AgentSync=$($BaseAgent.ToString('HH:mm')) C2Day=$($BaseC2Day.ToString('HH:mm')) C2Night=$($BaseC2Ngt.ToString('HH:mm')) FullSync=$($BaseFull.ToString('HH:mm')) Update=$($BaseUpdate.ToString('HH:mm')) Log=$($BaseLog.ToString('HH:mm'))"

    # TASK 1: SAM_Agent_Sync — Delta Sync ทุก 4 ชม. + Startup
    # Start time สุ่ม 06:00-09:59 → repeat ทุก 4 ชม.
    # --------------------------------------------------
    $T1_Startup = New-ScheduledTaskTrigger -AtStartup
    $T1_Repeat  = New-ScheduledTaskTrigger -Daily -At $BaseAgent
    $T1_Repeat.Repetition.Interval = "PT4H"
    $T1_Repeat.Repetition.Duration = "P1D"
    Register-SAMTask `
        -TaskName    $TASK_AGENT_SYNC `
        -ScriptFile  $AgentScript `
        -ExtraArgs   "-Silent -DeltaOnly" `
        -Triggers    @($T1_Startup, $T1_Repeat) `
        -Description "SAM: Delta Sync every 4hr (jitter start $($BaseAgent.ToString('HH:mm')))"

    # --------------------------------------------------
    # TASK 2: SAM_C2_Poll_Day — C2 กลางวัน ทุก 40 นาที
    # Start time สุ่ม 06:00-06:39
    # --------------------------------------------------
    $T2_Day = New-ScheduledTaskTrigger -Daily -At $BaseC2Day
    $T2_Day.Repetition.Interval = "PT40M"
    $T2_Day.Repetition.Duration = "PT11H"
    Register-SAMTask `
        -TaskName    $TASK_C2_DAY `
        -ScriptFile  $AgentScript `
        -ExtraArgs   "-Silent -C2Only" `
        -Triggers    @($T2_Day) `
        -Description "SAM: C2 Poll day every 40min (jitter start $($BaseC2Day.ToString('HH:mm')))"

    # --------------------------------------------------
    # TASK 3: SAM_C2_Poll_Night — C2 กลางคืน ทุก 80 นาที
    # Start time สุ่ม 17:00-18:19
    # --------------------------------------------------
    $T3_Night = New-ScheduledTaskTrigger -Daily -At $BaseC2Ngt
    $T3_Night.Repetition.Interval = "PT80M"
    $T3_Night.Repetition.Duration = "PT13H"
    Register-SAMTask `
        -TaskName    $TASK_C2_NIGHT `
        -ScriptFile  $AgentScript `
        -ExtraArgs   "-Silent -C2Only" `
        -Triggers    @($T3_Night) `
        -Description "SAM: C2 Poll night every 80min (jitter start $($BaseC2Ngt.ToString('HH:mm')))"

    # --------------------------------------------------
    # TASK 4: SAM_FullSync_Weekly — Full UPSERT ทุก วันจันทร์
    # Start time สุ่ม 02:00-07:59
    # --------------------------------------------------
    $T4 = New-ScheduledTaskTrigger -Weekly -DaysOfWeek Monday -At $BaseFull
    Register-SAMTask `
        -TaskName    $TASK_FULL_SYNC `
        -ScriptFile  $AgentScript `
        -ExtraArgs   "-Silent -ForceFullSync" `
        -Triggers    @($T4) `
        -Description "SAM: Weekly FullSync Monday (jitter $($BaseFull.ToString('HH:mm')))"

    # --------------------------------------------------
    # TASK 5: SAM_Update_Check — ตรวจ version
    # Start time สุ่ม 09:00-12:59
    # --------------------------------------------------
    $T5 = New-ScheduledTaskTrigger -Daily -At $BaseUpdate
    Register-SAMTask `
        -TaskName    $TASK_UPDATE_CHECK `
        -ScriptFile  $UpdateScript `
        -ExtraArgs   "-Silent" `
        -Triggers    @($T5) `
        -Description "SAM: Update check (jitter $($BaseUpdate.ToString('HH:mm')))"

    # --------------------------------------------------
    # TASK 6: SAM_LogRotate — ตัด Log เก่า
    # Start time สุ่ม 10:00-10:59
    # --------------------------------------------------
    $T6 = New-ScheduledTaskTrigger -Daily -At $BaseLog
    Register-SAMTask `
        -TaskName    $TASK_LOG_ROTATE `
        -ScriptFile  $SchedulerScript `
        -ExtraArgs   "-LogRotateOnly" `
        -Triggers    @($T6) `
        -Description "SAM: Log rotation (jitter $($BaseLog.ToString('HH:mm')))"

    # สร้าง Helper .bat files ทันทีหลัง Tasks ลง
    New-SAMHelperFiles
    Write-SAMLog "=== All SAM Tasks installed successfully ==="
}


# ==========================================
# CREATE HELPER .BAT FILES
# ==========================================
function New-SAMHelperFiles {
    Write-SAMLog "Creating helper .bat files..."

    $ForceSyncBat = @'
@echo off
net session >nul 2>&1
if %errorLevel% neq 0 (
    powershell -Command "Start-Process '%~f0' -Verb RunAs"
    exit /b
)
cd /d C:\IT_Support
if exist "LastState.json" del /q "LastState.json"
powershell.exe -ExecutionPolicy Bypass -File "SAM_Agent.ps1" -ForceFullSync
exit
'@

    $DeepScanBat = @'
@echo off
net session >nul 2>&1
if %errorLevel% neq 0 (
    powershell -Command "Start-Process '%~f0' -Verb RunAs"
    exit /b
)
cd /d C:\IT_Support
powershell.exe -WindowStyle Hidden -ExecutionPolicy Bypass -File "SAM_Agent.ps1" -Silent -DeepScan
exit
'@

    $UninstallBat = @'
@echo off
color 0C
title S.A.M. Uninstaller
net session >nul 2>&1
if %errorLevel% neq 0 (
    powershell -Command "Start-Process '%~dpnx0' -Verb RunAs"
    exit /b
)
echo Removing S.A.M. Agent...
powershell.exe -ExecutionPolicy Bypass -File "C:\IT_Support\SAM_Scheduler.ps1" -Uninstall
echo Uninstall complete.
pause
exit
'@

    $UpdateCheckBat = @'
@echo off
color 0B
title S.A.M. Force Update Check
net session >nul 2>&1
if %errorLevel% neq 0 (
    powershell -Command "Start-Process '%~f0' -Verb RunAs"
    exit /b
)
cd /d C:\IT_Support
echo Checking for updates...
powershell.exe -ExecutionPolicy Bypass -File "SAM_Update.ps1" -ForceCheck
pause
exit
'@

    $StatusBat = @'
@echo off
color 0E
title S.A.M. Status
cd /d C:\IT_Support
powershell.exe -ExecutionPolicy Bypass -File "SAM_Scheduler.ps1" -Status
pause
exit
'@

    $C2PollBat = @'
@echo off
color 09
title S.A.M. Manual C2 Poll
cd /d C:\IT_Support
echo Polling C2 command from Supabase...
powershell.exe -ExecutionPolicy Bypass -File "SAM_Agent.ps1" -C2Only
echo Done.
pause
exit
'@

    $BatFiles = @{
        "SAM_ForceSync.bat"    = $ForceSyncBat
        "SAM_DeepScan.bat"     = $DeepScanBat
        "SAM_Uninstall.bat"    = $UninstallBat
        "SAM_UpdateCheck.bat"  = $UpdateCheckBat
        "SAM_Status.bat"       = $StatusBat
        "SAM_C2Poll.bat"       = $C2PollBat
    }

    foreach ($BatName in $BatFiles.Keys) {
        $BatPath = "$WorkDir\$BatName"
        try {
            [System.IO.File]::WriteAllText($BatPath, $BatFiles[$BatName], [System.Text.Encoding]::ASCII)
            Write-SAMLog "Created: $BatName"
        } catch {
            Write-SAMLog "Failed to create $BatName : $($_.Exception.Message)" -Level "WARN"
        }
    }
    Write-SAMLog "Helper .bat files ready."
}

# ==========================================
# LOG ROTATION
# ==========================================
function Invoke-LogRotate-File {
    param([string]$FilePath, [int]$RetainDays, [string]$Label)
    if (-not (Test-Path $FilePath)) { return }
    try {
        $Cutoff   = (Get-Date).AddDays(-$RetainDays)
        $AllLines = Get-Content $FilePath -Encoding UTF8 -ErrorAction Stop
        $Kept     = $AllLines | Where-Object {
            if ($_ -match "^(\d{4}-\d{2}-\d{2})") {
                try { [datetime]::ParseExact($Matches[1],"yyyy-MM-dd",$null) -ge $Cutoff }
                catch { $true }
            } else { $true }
        }
        [System.IO.File]::WriteAllLines($FilePath, $Kept, [System.Text.Encoding]::UTF8)
        Write-SAMLog "$Label rotation: kept $($Kept.Count)/$($AllLines.Count) lines (retain $RetainDays days, cutoff $($Cutoff.ToString('yyyy-MM-dd')))"
    } catch {
        Write-SAMLog "$Label rotation error: $($_.Exception.Message)" -Level "WARN"
    }
}

function Invoke-LogRotation {
    # SAM_Log.txt        — เก็บ 7 วัน  (operational log)
    Invoke-LogRotate-File -FilePath $LogFile -RetainDays 7 -Label "SAM_Log"

    # SAM_ChangeLog.txt  — เก็บ 15 วัน (data change events)
    $ChangeLogFile = "$WorkDir\SAM_ChangeLog.txt"
    Invoke-LogRotate-File -FilePath $ChangeLogFile -RetainDays 15 -Label "SAM_ChangeLog"

    # SAM_Log_Offline.txt — เก็บ 7 วัน
    $OfflineLog = "$WorkDir\SAM_Log_Offline.txt"
    Invoke-LogRotate-File -FilePath $OfflineLog -RetainDays 7 -Label "SAM_Log_Offline"

    # ลบ HTML Report เก่าเกิน 7 วัน
    try {
        $OldHTML = Get-ChildItem -Path $WorkDir -Filter "*.html" -Recurse |
            Where-Object { $_.LastWriteTime -lt (Get-Date).AddDays(-7) }
        $OldHTML | Remove-Item -Force -ErrorAction SilentlyContinue
        if ($OldHTML.Count -gt 0) { Write-SAMLog "Removed $($OldHTML.Count) old HTML report(s)." }
    } catch {}

    # ลบ Offline JSON เก่าเกิน 15 วัน
    try {
        $OfflineRptDir = "$WorkDir\OfflineReports"
        if (Test-Path $OfflineRptDir) {
            $OldJSON = Get-ChildItem -Path $OfflineRptDir -Filter "*.json" |
                Where-Object { $_.LastWriteTime -lt (Get-Date).AddDays(-15) }
            $OldJSON | Remove-Item -Force -ErrorAction SilentlyContinue
            if ($OldJSON.Count -gt 0) { Write-SAMLog "Removed $($OldJSON.Count) old Offline JSON(s)." }
        }
    } catch {}
}

# ==========================================
# STATUS: แสดง Task Status
# ==========================================
function Show-SAMStatus {
    $TaskList = @(
        $TASK_AGENT_SYNC,
        $TASK_C2_DAY,
        $TASK_C2_NIGHT,
        $TASK_FULL_SYNC,
        $TASK_UPDATE_CHECK,
        $TASK_LOG_ROTATE
    )

    Write-Host "`n╔══════════════════════════════════════╗" -ForegroundColor Cyan
    Write-Host "║   S.A.M. SCHEDULER STATUS v$SAM_VERSION   ║" -ForegroundColor Cyan
    Write-Host "╚══════════════════════════════════════╝`n" -ForegroundColor Cyan

    foreach ($TName in $TaskList) {
        $Task = Get-ScheduledTask -TaskName $TName -ErrorAction SilentlyContinue
        $Info = Get-ScheduledTaskInfo -TaskName $TName -ErrorAction SilentlyContinue
        if ($Task) {
            $State     = $Task.State
            $LastRun   = if ($Info.LastRunTime -and $Info.LastRunTime.Year -gt 2000) { $Info.LastRunTime.ToString("yyyy-MM-dd HH:mm") } else { "Never" }
            $NextRun   = if ($Info.NextRunTime -and $Info.NextRunTime.Year -gt 2000) { $Info.NextRunTime.ToString("yyyy-MM-dd HH:mm") } else { "N/A" }
            $LastResult = $Info.LastTaskResult
            $StatusColor = if ($State -eq "Ready" -or $State -eq "Running") { "Green" } else { "Red" }
            Write-Host "  [✓] $TName" -ForegroundColor $StatusColor
            Write-Host "      State: $State | Last: $LastRun | Next: $NextRun | Result: $LastResult" -ForegroundColor Gray
        } else {
            Write-Host "  [✗] $TName  (NOT INSTALLED)" -ForegroundColor Red
        }
    }

    Write-Host ""
    if (Test-Path $StateFile) {
        $State = Get-Content $StateFile | ConvertFrom-Json
        Write-Host "  Last State Hash  : $($State.Hash)" -ForegroundColor DarkCyan
        Write-Host "  Last Write Time  : $($State.LastWriteTime)" -ForegroundColor DarkCyan
    }
    Write-Host ""
}

# ==========================================
# UNINSTALL
# ==========================================
function Uninstall-SAM {
    Write-SAMLog "=== SAM Uninstall requested ==="
    foreach ($TName in @($TASK_AGENT_SYNC,$TASK_C2_DAY,$TASK_C2_NIGHT,$TASK_FULL_SYNC,$TASK_UPDATE_CHECK,$TASK_LOG_ROTATE)) {
        schtasks /delete /tn $TName /f 2>$null | Out-Null
        Write-SAMLog "Removed task: $TName"
    }

    # Delayed folder removal via temp bat
    $CleanupBat = "$env:TEMP\sam_cleanup_$((Get-Random)).bat"
    @"
@echo off
ping 127.0.0.1 -n 4 >nul
icacls "C:\IT_Support" /reset /T /C /Q >nul 2>&1
attrib -h -s -r "C:\IT_Support" /s /d >nul 2>&1
rmdir /s /q "C:\IT_Support"
del "%~f0"
"@ | Out-File $CleanupBat -Encoding ASCII
    Start-Process "cmd.exe" -ArgumentList "/c `"$CleanupBat`"" -WindowStyle Hidden
    Write-Host "SAM uninstall queued. Folder will be removed momentarily." -ForegroundColor Yellow
}

# ==========================================
# ENTRY POINT — สวิตช์หลัก
# ==========================================

# Special mode: ถูกเรียกจาก Task ให้ Rotate Log เท่านั้น
if ($PSBoundParameters.ContainsKey('LogRotateOnly') -or ($args -contains "-LogRotateOnly")) {
    Invoke-LogRotation
    exit 0
}

if ($Status)    { Show-SAMStatus; exit 0 }
if ($Uninstall) { Uninstall-SAM;  exit 0 }

# ==========================================
# ENTRY POINT
# ==========================================
# -Setup    → ติดตั้ง Tasks + .bat เท่านั้น (Portal Web ใช้ — Agent รันแยก)
# (no flag) → ติดตั้ง Tasks + ล้าง state + รัน Agent -Silent ทันที (USB/manual)

Invoke-FolderBootstrap
Install-SAMTasks
Write-SAMLog "SAM Scheduler v$SAM_VERSION setup complete."

if ($Setup) {
    # Web Portal path: ลง tasks เสร็จแล้วออก
    # Agent จะถูกรันแยกจาก CMD ด้วย -Silent -ForceFullSync
    Write-SAMLog "Setup-only mode complete. Agent will be launched by caller."
    exit 0
}

# USB / Manual path: ล้าง state เก่า + รัน Agent ทันทีแบบ Silent
Write-SAMLog "=== Initial Deploy: Clearing old state ==="
Remove-Item "$WorkDir\LastState.json"   -Force -ErrorAction SilentlyContinue
Remove-Item "$WorkDir\UpdateState.json" -Force -ErrorAction SilentlyContinue
Get-ChildItem $WorkDir -Filter "*.html"  | Remove-Item -Force -ErrorAction SilentlyContinue
Write-SAMLog "Old state cleared."

Write-SAMLog "Launching Agent -Silent -ForceFullSync..."
Start-Process powershell.exe `
    -ArgumentList "-WindowStyle Hidden -ExecutionPolicy Bypass -File `"$AgentScript`" -Silent -ForceFullSync" `
    -WindowStyle Hidden
Write-SAMLog "Agent launched. Setup complete." 
